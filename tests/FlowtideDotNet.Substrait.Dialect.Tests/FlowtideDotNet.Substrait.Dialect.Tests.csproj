<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(DefaultNetTargetFramework)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FlowtideDotNet.Core/FlowtideDotNet.Core.csproj" />
    <ProjectReference Include="../../src/FlowtideDotNet.DependencyInjection/FlowtideDotNet.DependencyInjection.csproj" />
    <ProjectReference Include="../../tools/FlowtideDotNet.Substrait.DocGenerator/FlowtideDotNet.Substrait.DocGenerator.csproj" />
    <None Include="../../docs/reference/expressions.md;../../docs/reference/sql-functions.xml"
          Link="docs/reference/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/docs/expressions/functions-reference.md"
          Link="docs/docs/expressions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/llms/expressions.txt"
          Link="docs/llms/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FlowtideDotNet.Substrait.Documentation" />
    <Using Include="FlowtideDotNet.Substrait.Documentation.Catalog" />
  </ItemGroup>
</Project>
