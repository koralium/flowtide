<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>$(DefaultNetTargetFramework)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Existing and generated protobuf members are not all documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1574;CS1589</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	  <PackageReference Include="Google.Protobuf" />
	  <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	  <PackageReference Include="SqlParserCS" />
  </ItemGroup>

	<ItemGroup>
		<Protobuf Include="proto/substrait/**/*.proto" ProtoRoot="proto/" CompileOutputs="false" OutputDir="generated/proto/" GrpcServices="None" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="CustomProto\custom_proto.proto" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="CustomProto\custom_proto.proto" AdditionalImportDirs="proto/" />
	</ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="../../docs/reference/sql-functions.xml" />
  </ItemGroup>
</Project>
