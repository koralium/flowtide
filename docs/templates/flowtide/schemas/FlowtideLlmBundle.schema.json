{
  "$schema": "https://dotnet.github.io/docfx/schemas/v1.0/schema.json#",
  "version": "1.0.0",
  "title": "FlowtideLlmBundle",
  "description": "A plain-text bundle assembled from the maintained application guides.",
  "type": "object",
  "properties": {
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "reference": "file"
          }
        }
      }
    }
  }
}
